#. translators: 1: organization noun, 2: admin noun, 3: plural member noun, 4: plural location noun.
#: includes/Admin/Settings.php:355
#, php-format
msgid "Currently: %1$s, %2$s, %3$s, %4$s."
msgstr "Aktuell: %1$s, %2$s, %3$s, %4$s."

#: includes/Admin/Settings.php:372
msgid "WooCommerce's own registration form is switched off while this plugin is active: every account belongs to an organization, so accounts are created here or through an invitation."
msgstr "Das Registrierungsformular von WooCommerce ist ausgeschaltet, solange dieses Plugin aktiv ist: Jedes Konto gehört zu einer Organisation, Konten entstehen also hier oder über eine Einladung."

#. translators: %s: the plural organization noun for the site's mode.
#: includes/Admin/Settings.php:407
#, php-format
msgid "New %s must be approved before they can order"
msgstr "Neue %s müssen freigegeben werden, bevor sie bestellen können"

#: includes/Admin/Settings.php:415
msgid "With this off, a new registration is active immediately."
msgstr "Ist dies ausgeschaltet, ist eine neue Registrierung sofort aktiv."

#: includes/Admin/Settings.php:463
msgid "— Select —"
msgstr "— Auswählen —"

#. translators: %s: the registration shortcode.
#: includes/Admin/Settings.php:478
