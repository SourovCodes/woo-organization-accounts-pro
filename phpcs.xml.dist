<?xml version="1.0"?>
<ruleset name="WooCommerce Organization Accounts Pro">
	<description>Coding standards for the WooCommerce Organization Accounts Pro plugin.</description>

	<!-- Scan the whole plugin by default so `composer lint` needs no arguments. -->
	<file>.</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<!-- Build output: a staged copy of the same files bin/build-zip.sh already linted. -->
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/tests/fixtures/*</exclude-pattern>
	<!-- Generated by bin/install-wp-tests.sh; it defines WordPress core constants. -->
	<exclude-pattern>*/tests/wp-tests-config.php</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>

	<!-- Only PHP files, and show progress plus the sniff name so violations are actionable. -->
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg value="ps"/>

	<!-- The WooCommerce standard layers WooCommerce conventions on top of WordPress-Extra. -->
	<rule ref="WooCommerce-Core"/>

	<!-- PHPCompatibilityWP: the plugin declares "Requires PHP: 8.2". -->
	<config name="testVersion" value="8.2-"/>

	<!-- WordPress version floor used by the deprecation sniffs. -->
	<config name="minimum_wp_version" value="7.0"/>

	<!-- Every translatable string must use the plugin's own text domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="woo-organization-accounts-pro"/>
			</property>
		</properties>
	</rule>

	<!-- Globals, hooks and options must be namespaced to the plugin. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="woap"/>
				<element value="woo_org_accounts"/>
				<element value="WooOrgAccounts"/>
			</property>
		</properties>
	</rule>

	<!--
		An email template is required to fire WooCommerce's own header and footer hooks
		and to apply its footer-text filter — that is what makes the message look like
		the rest of the shop's mail and honour the site's email settings. They are
		WooCommerce's hooks by design, so the prefix rule and the "document your hook"
		rule cannot apply to them. Scoped to the email templates and nowhere else.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound">
		<exclude-pattern>*/templates/emails/*</exclude-pattern>
	</rule>
	<rule ref="WooCommerce.Commenting.CommentHooks.MissingHookComment">
		<exclude-pattern>*/templates/emails/*</exclude-pattern>
	</rule>

	<!--
		Capabilities the sniff cannot discover on its own: WooCommerce's, and this
		plugin's own, which are granted at runtime from the membership row by
		WooOrgAccounts\Capabilities rather than through WP_Role::add_cap().
	-->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
				<element value="view_woocommerce_reports"/>
				<element value="edit_shop_orders"/>
				<element value="view_order"/>
				<element value="woap_manage_organization"/>
				<element value="woap_manage_billing"/>
				<element value="woap_manage_locations"/>
				<element value="woap_manage_members"/>
				<element value="woap_invite_members"/>
				<element value="woap_view_organization_orders"/>
				<element value="woap_place_orders"/>
			</property>
		</properties>
	</rule>

	<!-- Class files follow PSR-4 for the autoloader, not the WordPress class-*.php convention. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/includes/*</exclude-pattern>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!--
		The PHPUnit bootstrap runs before WordPress exists. putenv() is how wp-phpunit
		is pointed at its config file, the escaping functions are not loaded yet when it
		reports a fatal setup problem, and rebuilding $GLOBALS['wp_roles'] is the
		documented way to pick up the roles WC_Install() adds. Scoped to that one file.
	-->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.runtime_configuration_putenv">
		<exclude-pattern>*/tests/bootstrap.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>*/tests/bootstrap.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>*/tests/bootstrap.php</exclude-pattern>
	</rule>

	<!-- Test methods are camelCase per PHPUnit, and test files legitimately use direct queries. -->
	<rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
</ruleset>
